    {
      'cell_type': 'code',
      'source': [
        'motifs = {}\n',
        'motifs_num = 0\n',
        'with MotifFile(\'dpinteract.meme\') as motif_file:\n',
        '    motif = motif_file.read()\n',
        '    while motif: \n',
        '      motifs_num+=1\n',
        '      motif_name=motif.accession.decode()\n',
        '      motifs[motif_name]=motif\n',
        '      motif = motif_file.read()\n',
        '\n',
        'with MotifFile(\'SwissRegulon_e_coli.meme\') as motif_file:\n',
        '    motif = motif_file.read()\n',
        '    while motif: \n',
        '      motifs_num+=1\n',
        '      motif_name=motif.accession.decode()\n',
        '      motifs[motif_name]=motif\n',
        '      motif = motif_file.read()\n',
        '\n',
        'assert motifs_num==len(motifs)'
      ],
      'metadata': {
