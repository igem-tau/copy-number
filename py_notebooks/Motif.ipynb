    {
      'cell_type': 'code',
      'source': [
        'def get_motifs_matches(motifs, seq, threshold=0.05):\n',
        '  matches=[]\n',
        '  fimo = FIMO(both_strands=True, threshold=threshold)\n',
        '  for selected_motif in motifs.values():\n',
        '    pattern = fimo.score_motif(selected_motif, [Sequence(seq)], motif_file.background)\n',
        '    for m in pattern.matched_elements:\n',
        '      matches.append({\n',
        '          \'motif_name\':selected_motif.accession.decode(),\n',
        '            \'motif_start\':m.start,\n',
        '            \'motif_stop\':m.stop,\n',
        '            \'motif_strand\':m.strand,\n',
        '            \'motif_score\':m.score,\n',
        '            \'motif_pvalue\':m.pvalue,\n',
        '            \'motif_qvalue\':m.qvalue\n',
        '      })\n',
        '  return matches\n'
      ],
      'metadata': {
        'id': 'Oq2ATfTMNTff'
      },
      'execution_count': null,
      'outputs': []
    },
    {
      'cell_type': 'code',
      'source': [
        'def get_motifs_matches_as_features(motifs, seq, threshold=0.05):\n',
        '  features=[]\n',
        '  matches=get_motifs_matches(motifs, seq, threshold)\n',
        '  for motif_match in matches:\n',
        '    #Currently taking all matches, but maybe maximal value per motif?\n',
        '    features.append({motif_match[\'motif_name\']+str(motif_match[\'motif_start\'])+motif_match[\'motif_strand\']:motif_match[\'motif_score\']})\n',
        '  return features'
      ],
      'metadata': {
        'id': 's8zjySkGTNUP'
      },
      'execution_count': null,
      'outputs': []
    },
